# Development local com SQLite
APP_ENV=development
DATABASE_URL=sqlite:///./data/app/dash_rh.db

# Produção ou homologação: use PostgreSQL
# DATABASE_URL=postgresql+psycopg://dashrh_user:change-me@postgres:5432/dash_rh
POSTGRES_DB=dash_rh
POSTGRES_USER=dash_rh
POSTGRES_PASSWORD=change-me

# Nunca use segredos reais em arquivo versionado
SECRET_KEY=change-me
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups
LOG_LEVEL=INFO
LOG_TO_FILE=false

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin@123

# Notificações externas ficam desativadas por padrão
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

WEBHOOK_ENABLED=false
WEBHOOK_URL=
